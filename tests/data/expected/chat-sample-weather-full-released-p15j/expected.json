  "decoded_text": "<s>[SYSTEM_PROMPT]Don't make assumptions about what values to plug into functions.[/SYSTEM_PROMPT][SYSTEM_PROMPT]Ask for clarification if a user request is ambiguous.[/SYSTEM_PROMPT][AVAILABLE_TOOLS][{\"type\": \"function\", \"function\": {\"name\": \"get_current_weather\", \"description\": \"Get the current weather\", \"parameters\": {\"type\": \"object\", \"properties\": {\"location\": {\"type\": \"string\", \"description\": \"The city and state, e.g. San Francisco, CA\"}, \"format\": {\"type\": \"string\", \"enum\": [\"celsius\", \"fahrenheit\"], \"description\": \"The temperature unit to use. Infer this from the users location.\"}}, \"required\": [\"location\", \"format\"]}}}, {\"type\": \"function\", \"function\": {\"name\": \"get_n_day_weather_forecast\", \"description\": \"Get an N-day weather forecast\", \"parameters\": {\"type\": \"object\", \"properties\": {\"location\": {\"type\": \"string\", \"description\": \"The city and state, e.g. San Francisco, CA\"}, \"format\": {\"type\": \"string\", \"enum\": [\"celsius\", \"fahrenheit\"], \"description\": \"The temperature unit to use. Infer this from the users location.\"}, \"num_days\": {\"type\": \"integer\", \"description\": \"The number of days to forecast\"}}, \"required\": [\"location\", \"format\", \"num_days\"]}}}][/AVAILABLE_TOOLS][MODEL_SETTINGS]{\"reasoning_effort\": \"high\"}[/MODEL_SETTINGS][INST]What's the weather like today[/INST]Sure, can you please provide me with your location?</s>[INST]I'm in Paris, France.[/INST][TOOL_CALLS]get_current_weather[ARGS]{\"location\": \"Paris, France\", \"format\": \"celsius\"}</s>[TOOL_RESULTS]22[/TOOL_RESULTS]The current temperature in Paris, France is 22 degrees Celsius.</s>[INST]what is the weather going to be like in Paris, France over the next x days[/INST]Please tell me the number of days you want the weather forecast for.</s>[INST]5 days[/INST][TOOL_CALLS]get_n_day_weather_forecast[ARGS]{\"location\": \"Paris, France\", \"format\": \"celsius\", \"num_days\": 5}</s>[TOOL_RESULTS]{\"2024-05-22\":\"22\",\"2024-05-23\":\"23\",\"2024-05-24\":\"24\",\"2024-05-25\":\"25\",\"2024-05-26\":\"26\"}[/TOOL_RESULTS]",
